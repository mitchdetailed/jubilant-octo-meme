# 08_REPO_AND_BUILD.md section 12: LF everywhere, binary formats untouched.
* text=auto eol=lf
*.cmd text eol=crlf
*.bat text eol=crlf

*.ld binary
# .ldx is XML, but fixtures must round-trip byte-identical (AC-M0-03): never convert its line endings.
*.ldx -text
*.png binary
*.jpg binary
*.ico binary
*.icns binary
*.gz binary
*.zip binary
*.ttf binary
*.otf binary
*.pdf binary

# Vendored code is stored byte-for-byte so the SHA-256 records in third_party/README.md and
# third_party/qtads/UPSTREAM.md match on every checkout (no line-ending normalisation).
third_party/** -text

# Test fixtures are stored byte-for-byte: line endings, encodings and BOMs are part of what they test
# (e.g. fixtures/motec.csv/dialect-basic is CRLF by design).
fixtures/** -text
