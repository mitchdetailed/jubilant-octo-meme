{
  "$schema": "urn:esses:maths-case-1",
  "schemaVersion": 1,
  "id": "running_min_gated_reset",
  "expression": "running_min('X', 'C', range_change(\"Outings:Laps\"))",
  "provenance": {
    "kind": "release-notes",
    "ref": "03_MATHS_ENGINE.md 5.4: running_min/max",
    "note": "holds while gated off; restarts per lap; invalid before the first gated sample"
  },
  "rate": "auto",
  "compat": {},
  "precision": "single",
  "durationUs": 1200000,
  "inputs": {
    "X": {
      "rate": {
        "num": 10,
        "den": 1
      },
      "unit": "",
      "values": [3, 1.5, 4.25, 1, 5.5, 9, 2.75, 6.5, 5.25, 3.5, 5, 8.75]
    },
    "C": {
      "rate": {
        "num": 10,
        "den": 1
      },
      "unit": "",
      "values": [1, 1, 0, 0, 1, 1, 1, 0, 1, 0, 1, 1]
    }
  },
  "ranges": {
    "Outings": [
      {
        "startUs": 0,
        "endUs": 1200000
      }
    ],
    "Outings:Laps": [
      {
        "startUs": 0,
        "endUs": 400000
      },
      {
        "startUs": 400000,
        "endUs": 800000
      },
      {
        "startUs": 800000,
        "endUs": 1200000
      }
    ]
  },
  "expected": {
    "rate": {
      "num": 10,
      "den": 1
    },
    "values": [3, 1.5, 1.5, 1.5, 5.5, 5.5, 2.75, 2.75, 5.25, 5.25, 5, 5],
    "tolerance": {
      "abs": 1e-06,
      "rel": 1e-06
    }
  }
}
