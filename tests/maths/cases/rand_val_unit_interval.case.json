{
  "$schema": "urn:esses:maths-case-1",
  "schemaVersion": 1,
  "id": "rand_val_unit_interval",
  "expression": "rand_val() >= 0 && rand_val() < 1 && 'X' == 'X'",
  "provenance": {
    "kind": "derived",
    "ref": "Maths Functions (Pro): rand_val",
    "note": "one value in [0, 1) per evaluation (D-087)"
  },
  "rate": "auto",
  "compat": {},
  "precision": "single",
  "durationUs": 800000,
  "inputs": {
    "X": {
      "rate": {
        "num": 10,
        "den": 1
      },
      "unit": "",
      "values": [-2.5, -1.5, -0.5, 0.5, 1.5, 2.5, -3.75, 3.75]
    }
  },
  "expected": {
    "rate": {
      "num": 10,
      "den": 1
    },
    "values": [1, 1, 1, 1, 1, 1, 1, 1],
    "tolerance": {
      "abs": 1e-06,
      "rel": 1e-06
    }
  }
}
