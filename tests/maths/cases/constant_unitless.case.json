{
  "$schema": "urn:esses:maths-case-1",
  "schemaVersion": 1,
  "id": "constant_unitless",
  "expression": "'X' * 'Gain' + 'Offset'",
  "provenance": {
    "kind": "derived",
    "ref": "Maths Constants (Pro)",
    "note": "constants are quoted like channels"
  },
  "rate": "auto",
  "compat": {},
  "precision": "single",
  "durationUs": 400000,
  "inputs": {
    "X": {
      "rate": {
        "num": 10,
        "den": 1
      },
      "unit": "",
      "values": [1, 2, 3, 4]
    }
  },
  "constants": {
    "Gain": {
      "v": 2.5,
      "unit": ""
    },
    "Offset": {
      "v": -1,
      "unit": ""
    }
  },
  "expected": {
    "rate": {
      "num": 10,
      "den": 1
    },
    "values": [1.5, 4, 6.5, 9],
    "tolerance": {
      "abs": 1e-06,
      "rel": 1e-06
    }
  }
}
