#
# Script mode (cmake -P), run after a Catch2 v3 test executable links; see catch_discover.cmake.
#   -DTEST_EXECUTABLE=<exe> -DCTEST_FILE=<out.cmake> [-DTEST_WORKING_DIR=<dir>] [-DTEST_PREFIX=<p>]
#   [-DTEST_TIMEOUT=<s>] [-DTEST_TAGS=<t1@t2...>] [-DTEST_LABELS=<l1@l2...>] [-DTEST_SPEC=<catch2 test spec>]
# TEST_SPEC narrows the listing (the discovery self-tests use it to list hidden test cases).
#
# The listing comes from `--list-tests --reporter json`, so a name is never split at ';' or at a line break and
# the tags arrive with each name. Names are kept out of CMake lists: every name and spec is written into the
# ctest file as a bracket argument whose '=' level does not occur in the text. ctest passes each test the
# quoted, escaped name as its Catch2 test spec, which selects exactly that test case.
cmake_minimum_required(VERSION 3.28)

foreach(_v TEST_EXECUTABLE CTEST_FILE)
  if(NOT DEFINED ${_v} OR "${${_v}}" STREQUAL "")
    message(FATAL_ERROR "catch_discover_tests: -D${_v}=... is required")
  endif()
endforeach()
if(NOT TEST_WORKING_DIR)
  get_filename_component(TEST_WORKING_DIR "${TEST_EXECUTABLE}" DIRECTORY)
endif()
if(NOT TEST_TIMEOUT)
  set(TEST_TIMEOUT 600)
endif()

# [=[value]=] with enough '=' that the closing delimiter cannot occur inside the value.
function(_esses_bracket out value)
  set(eq "=")
  while(TRUE)
    string(FIND "${value}]" "]${eq}]" pos)
    if(pos EQUAL -1)
      break()
    endif()
    string(APPEND eq "=")
  endwhile()
  set(${out} "[${eq}[${value}]${eq}]" PARENT_SCOPE)
endfunction()

if(DEFINED TEST_SPEC AND NOT "${TEST_SPEC}" STREQUAL "")
  execute_process(COMMAND "${TEST_EXECUTABLE}" "${TEST_SPEC}" --list-tests --reporter json
                  WORKING_DIRECTORY "${TEST_WORKING_DIR}" ENCODING UTF-8
                  OUTPUT_VARIABLE listing ERROR_VARIABLE err RESULT_VARIABLE rc)
else()
  execute_process(COMMAND "${TEST_EXECUTABLE}" --list-tests --reporter json
                  WORKING_DIRECTORY "${TEST_WORKING_DIR}" ENCODING UTF-8
                  OUTPUT_VARIABLE listing ERROR_VARIABLE err RESULT_VARIABLE rc)
endif()
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "catch_discover_tests: listing the tests of ${TEST_EXECUTABLE} failed (${rc})\n"
                      "${err}\n${listing}")
endif()
string(JSON tests ERROR_VARIABLE json_err GET "${listing}" listings tests)
if(json_err)
  message(FATAL_ERROR "catch_discover_tests: unexpected listing from ${TEST_EXECUTABLE}: ${json_err}\n${listing}")
endif()
string(JSON count LENGTH "${tests}")

string(REPLACE "@" ";" known_tags "${TEST_TAGS}")
string(REPLACE "@" ";" extra_labels "${TEST_LABELS}")
_esses_bracket(q_exe "${TEST_EXECUTABLE}")
_esses_bracket(q_dir "${TEST_WORKING_DIR}")

set(content "# Generated by catch_discover_tests.cmake from ${TEST_EXECUTABLE}; do not edit.\n")
set(problems "")
if(count GREATER 0)
  math(EXPR last "${count} - 1")
  foreach(i RANGE ${last})
    string(JSON name GET "${tests}" ${i} name)

    # A Catch2 test spec matches names case-insensitively after trimming, and treats a leading or trailing '*'
    # as a wildcard and an "exclude:" prefix as a negation; such names cannot be selected exactly. Catch2 v3
    # also accepts one name twice when the tags differ.
    set(why "")
    if(name MATCHES "[\r\n]")
      set(why "contains a line break")
    elseif(name MATCHES "^\\*" OR name MATCHES "\\*$")
      set(why "starts or ends with '*' (a wildcard in a test spec)")
    elseif(name MATCHES "^exclude:")
      set(why "starts with 'exclude:' (a negation in a test spec)")
    else()
      string(TOLOWER "${name}" folded)
      string(STRIP "${folded}" folded)
      string(MD5 key "${folded}")
      if(DEFINED seen_${key})
        set(why "is not unique once case and surrounding spaces are ignored (see \"${seen_${key}}\")")
      endif()
      set(seen_${key} "${name}")
    endif()
    if(NOT why STREQUAL "")
      string(APPEND problems "  \"${name}\" ${why}\n")
      continue()
    endif()

    # Quoted spec: inside "..." only '\', '"' and ',' are special to Catch2's spec parser; '\' escapes them.
    string(REPLACE "\\" "\\\\" spec "${name}")
    string(REPLACE "\"" "\\\"" spec "${spec}")
    string(REPLACE "," "\\," spec "${spec}")
    set(spec "\"${spec}\"")

    set(labels ${extra_labels})
    string(JSON ntags LENGTH "${tests}" ${i} tags)
    if(ntags GREATER 0)
      math(EXPR tag_last "${ntags} - 1")
      foreach(j RANGE ${tag_last})
        string(JSON tag GET "${tests}" ${i} tags ${j})
        if(tag IN_LIST known_tags)
          list(APPEND labels "${tag}")
        endif()
      endforeach()
    endif()
    list(REMOVE_DUPLICATES labels)
    string(JOIN ";" labels_joined ${labels})

    _esses_bracket(q_name "${TEST_PREFIX}${name}")
    _esses_bracket(q_spec "${spec}")
    _esses_bracket(q_labels "${labels_joined}")
    string(APPEND content
      "add_test(${q_name} ${q_exe} ${q_spec} --reporter compact)\n"
      "set_tests_properties(${q_name} PROPERTIES WORKING_DIRECTORY ${q_dir} TIMEOUT ${TEST_TIMEOUT}"
      " SKIP_RETURN_CODE 4 LABELS ${q_labels})\n")
  endforeach()
endif()

if(NOT problems STREQUAL "")
  file(REMOVE "${CTEST_FILE}")
  message(FATAL_ERROR "catch_discover_tests: test names in ${TEST_EXECUTABLE} that a Catch2 test spec cannot "
                      "select exactly; rename them:\n${problems}")
endif()
file(WRITE "${CTEST_FILE}" "${content}")
