{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:esses:components/time_report-1",
  "title": "time_report component body",
  "description": "The body of a time_report component (04 section 13 item 7): scope, the section row group, untrusted laps, the summary rows, % bands and the time format.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "scope": {
      "enum": ["selectedRanges", "selectedOutings"]
    },
    "rowGroup": {
      "type": "string",
      "minLength": 1
    },
    "options": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "includeUntrusted": {
          "type": "boolean"
        }
      }
    },
    "summaries": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "eclectic": {
          "type": "boolean"
        },
        "rollingMin": {
          "type": "boolean"
        },
        "total": {
          "type": "boolean"
        }
      }
    },
    "bands": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pct"],
        "properties": {
          "pct": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "colour": {
            "$ref": "#/definitions/colour"
          },
          "visible": {
            "type": "boolean"
          }
        }
      }
    },
    "timeFormat": {
      "enum": ["project", "s.mmm", "m:ss.mmm"]
    }
  },
  "definitions": {
    "colour": {
      "description": "A colour \"#rrggbb\" (alpha ff) or \"#rrggbbaa\"; written in lower case (Rgba, 04 section 5.1).",
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?$"
    }
  }
}
