{
  "$schema": "urn:esses:keymap-1",
  "schemaVersion": 1,
  "bindings": [
    {
      "command": "data.toggle_domain",
      "context": "global",
      "keys": ["F9"]
    },
    {
      "command": "data.select_main",
      "context": "data_window",
      "keys": ["Return", "Enter"]
    },
    {
      "command": "cursor.insert_marker",
      "context": "graph",
      "keys": ["Shift+F7"]
    },
    {
      "command": "edit.undo",
      "context": "global",
      "keys": ["Ctrl+Z"]
    }
  ],
  "inherits": "default",
  "name": "user",
  "unbind": [
    {
      "command": "file.print",
      "context": "global"
    }
  ]
}
