{
  "$schema": "urn:esses:scheme-1",
  "schemaVersion": 1,
  "background": "dark",
  "fonts": {
    "caption": {
      "family": "Noto Sans",
      "italic": false,
      "pointSize": 9,
      "weight": 700
    },
    "keyStrikeout": {
      "family": "Noto Sans",
      "italic": false,
      "pointSize": 9,
      "strikeOut": true,
      "weight": 400
    }
  },
  "name": "Night Session",
  "overlayStyle": {
    "colourSource": "overlayPalette",
    "dash": "dash",
    "lightness": -0.2,
    "widthScale": 1.5
  },
  "print": {
    "paper": "A4",
    "roles": {
      "cptBackground": "#ffffff"
    }
  },
  "roles": {
    "cptBackground": "#000000",
    "cursorMain": "#FF2020",
    "overlay0": "#bdbdbd80"
  }
}
