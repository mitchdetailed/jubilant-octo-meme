#
# esses-cli eval goldens (AC-M2-14; ctest cli.eval.*). Two modes:
#   MODE=linear  runs `eval EXPR INPUT --csv` and checks every row against the oracle's channel CSV EXPECTED
#                (expected.channels/<NNN>_<name>.csv, written by tools/ld_ref_decode.py, D-041): the same
#                times, the same validity, and value = SCALE * oracle + OFFSET (integer channels only: CMake
#                arithmetic is integer).
#   MODE=json    runs `eval EXPR INPUT --json ARGS...` and checks the members RATE_NUM, RATE_DEN, UNIT, DTYPE,
#                COUNT (and FIRST_VALUE when given) of results[0].
# Arguments: CLI, INPUT, EXPR, WORK (a scratch directory), and the members above.

foreach(_var CLI INPUT EXPR WORK MODE)
  if(NOT DEFINED ${_var})
    message(FATAL_ERROR "eval_golden.cmake: ${_var} is not set")
  endif()
endforeach()
if(NOT EXISTS "${INPUT}")
  message(FATAL_ERROR "eval_golden.cmake: ${INPUT} does not exist (fixtures.generate_inputs writes it)")
endif()
file(MAKE_DIRECTORY "${WORK}")

if(MODE STREQUAL "linear")
  set(_out "${WORK}/eval.csv")
  execute_process(COMMAND "${CLI}" eval "${EXPR}" "${INPUT}" --csv -o "${_out}"
                  RESULT_VARIABLE _rc ERROR_VARIABLE _err)
  if(NOT _rc EQUAL 0)
    message(FATAL_ERROR "esses-cli eval failed (${_rc}): ${_err}")
  endif()
  file(STRINGS "${_out}" _got)
  file(STRINGS "${EXPECTED}" _want)
  list(LENGTH _got _ngot)
  list(LENGTH _want _nwant)
  if(NOT _ngot EQUAL _nwant)
    message(FATAL_ERROR "eval gave ${_ngot} lines, the oracle ${_nwant}")
  endif()
  math(EXPR _last "${_ngot} - 1")
  foreach(_i RANGE 1 ${_last})
    list(GET _got ${_i} _g)
    list(GET _want ${_i} _w)
    string(REPLACE "," ";" _g "${_g}")
    string(REPLACE "," ";" _w "${_w}")
    list(GET _g 0 _gt)
    list(GET _g 1 _gv)
    list(GET _g 2 _gok)
    list(GET _w 1 _wt)
    list(GET _w 2 _wv)
    list(GET _w 3 _wok)
    if(NOT _gt STREQUAL _wt OR NOT _gok STREQUAL _wok)
      message(FATAL_ERROR "row ${_i}: time/validity ${_gt}/${_gok}, the oracle ${_wt}/${_wok}")
    endif()
    if(_wok STREQUAL "1")
      string(REGEX REPLACE "\\.0$" "" _wv "${_wv}")
      math(EXPR _expect "${SCALE} * ${_wv} + ${OFFSET}")
      if(NOT _gv STREQUAL _expect)
        message(FATAL_ERROR "row ${_i} (t = ${_gt} us): ${_gv}, expected ${_expect} from the oracle value ${_wv}")
      endif()
    endif()
  endforeach()
  message(STATUS "eval golden: ${_last} rows equal ${SCALE} * oracle + ${OFFSET}")
elseif(MODE STREQUAL "json")
  set(_out "${WORK}/eval.json")
  separate_arguments(_args UNIX_COMMAND "${ARGS}")
  execute_process(COMMAND "${CLI}" eval "${EXPR}" "${INPUT}" --json -o "${_out}" ${_args}
                  RESULT_VARIABLE _rc ERROR_VARIABLE _err)
  if(NOT _rc EQUAL 0)
    message(FATAL_ERROR "esses-cli eval failed (${_rc}): ${_err}")
  endif()
  file(READ "${_out}" _doc)
  string(JSON _num GET "${_doc}" results 0 rate num)
  string(JSON _den GET "${_doc}" results 0 rate den)
  string(JSON _unit GET "${_doc}" results 0 unit)
  string(JSON _dtype GET "${_doc}" results 0 dtype)
  string(JSON _count GET "${_doc}" results 0 count)
  string(JSON _nvalues LENGTH "${_doc}" results 0 values)
  if(NOT _count EQUAL _nvalues OR _count EQUAL 0)
    message(FATAL_ERROR "eval --json: count ${_count} and ${_nvalues} values")
  endif()
  foreach(_pair "RATE_NUM;${_num}" "RATE_DEN;${_den}" "UNIT;${_unit}" "DTYPE;${_dtype}" "COUNT;${_count}")
    list(GET _pair 0 _key)
    list(GET _pair 1 _value)
    if(DEFINED ${_key} AND NOT "${_value}" STREQUAL "${${_key}}")
      message(FATAL_ERROR "eval --json: ${_key} is '${_value}', expected '${${_key}}'")
    endif()
  endforeach()
  if(DEFINED FIRST_VALUE)
    string(JSON _first GET "${_doc}" results 0 values 0)
    if(NOT _first STREQUAL FIRST_VALUE)
      message(FATAL_ERROR "eval --json: the first value is ${_first}, expected ${FIRST_VALUE}")
    endif()
  endif()
  message(STATUS "eval --json: rate ${_num}/${_den}, unit '${_unit}', ${_count} values")
else()
  message(FATAL_ERROR "eval_golden.cmake: unknown MODE ${MODE}")
endif()
