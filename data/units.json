    { "name": "Time", "family": "Time", "dim": [0, 0, 1, 0, 0, 0, 0], "base": "s",
      "units": [
        { "symbol": "s", "aliases": ["sec", "secs", "second", "seconds"] },
        { "symbol": "ms", "scalar": 1000, "aliases": ["msec", "millisecond", "milliseconds"] },
