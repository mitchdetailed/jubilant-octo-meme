        { "symbol": "mph", "toBase": 0.44704, "aliases": ["mi/h", "mile/h", "miles/h"], "note": "NIST SP 811: 1 mi/h = 0.44704 m/s exactly." },
        { "symbol": "ft/s", "toBase": 0.3048 },
        { "symbol": "mm/s", "scalar": 1000 },
        { "symbol": "in/s", "toBase": 0.0254 } ] },

