    { "name": "Pressure", "family": "Pressure", "dim": [-1, 1, -2, 0, 0, 0, 0], "base": "Pa", "deltaFamily": "Pressure Delta",
      "note": "Absolute pressure. Bare spellings (kPa, MPa, bar, psi) are absolute; gauge and differential pressures are Pressure Delta.",
      "units": [
