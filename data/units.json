        { "symbol": "day", "toBase": 86400, "aliases": ["days"] } ] },

    { "name": "Frequency", "family": "Frequency", "dim": [0, 0, -1, 0, 0, 0, 0], "base": "Hz",
      "units": [
        { "symbol": "Hz", "aliases": ["hertz", "1/s"] },
        { "symbol": "kHz", "scalar": 0.001 } ] },

    { "name": "Angular Speed", "family": "Angular Speed", "dim": [0, 0, -1, 0, 0, 0, 0], "base": "rad/s", "aliases": ["Angular Velocity"],
      "units": [
        { "symbol": "rad/s" },
        { "symbol": "rpm", "scalar": 9.549296585513721, "aliases": ["r/min", "rev/min", "revs/min"], "note": "60 / (2 pi) revolutions per minute per rad/s." },
        { "symbol": "1000rpm", "scalar": 0.009549296585513721, "compat": "legacy", "aliases": ["rpm1000", "krpm"] },
        { "symbol": "deg/s", "display": "°/s", "scalar": 57.29577951308232, "aliases": ["deg/sec", "degrees/sec"] } ] },

    { "name": "Angular Acceleration", "family": "Angular Acceleration", "dim": [0, 0, -2, 0, 0, 0, 0], "base": "rad/s/s",
      "units": [
        { "symbol": "rad/s/s", "display": "rad/s²", "aliases": ["rad/s2"] },
        { "symbol": "rpm/s", "scalar": 9.549296585513721 },
        { "symbol": "rpm/ms", "scalar": 0.009549296585513721 },
        { "symbol": "deg/s/s", "display": "°/s²", "scalar": 57.29577951308232, "aliases": ["deg/s2"] } ] },

    { "name": "Mass", "family": "Mass", "dim": [0, 1, 0, 0, 0, 0, 0], "base": "kg",
      "units": [
        { "symbol": "kg", "aliases": ["kilogram", "kilograms"] },
        { "symbol": "g", "scalar": 1000, "caseSensitive": ["g"], "aliases": ["gram", "grams"], "note": "The symbol 'g' matches only exactly; upper-case 'G' is the acceleration unit." },
        { "symbol": "mg", "scalar": 1000000, "aliases": ["milligram", "milligrams"] },
        { "symbol": "lbm", "toBase": 0.45359237, "aliases": ["pound", "pounds"], "note": "NIST SP 811: 1 lb (avoirdupois) = 0.45359237 kg exactly. The bare spelling 'lb' is the force unit lbf, because logged channels use it for force." } ] },

    { "name": "Force", "family": "Force", "dim": [1, 1, -2, 0, 0, 0, 0], "base": "N",
