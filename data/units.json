        { "symbol": "lbf.in", "display": "lbf·in", "toBase": 0.1129848290276167, "aliases": ["lb.in", "lb in", "in.lb", "in lb", "in-lb"], "note": "4.4482216152605 N x 0.0254 m exactly." } ] },

