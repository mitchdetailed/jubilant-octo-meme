{
  "$schema": "urn:esses:units-1",
  "schemaVersion": 1,
  "note": "Esses unit table (02_DATA_MODEL.md section 2, D-010, D-141). Our own table: quantities, dimension vectors [L, M, T, I, Theta, N, J], base units and conversion factors come from the SI Brochure (9th edition) and NIST SP 811 (2008 edition, appendix B) for SI and customary units, plus standard automotive units; sized by need (the shipped readers, dictionaries, maths and components, and the unit spellings of the private S-1 log corpus). value_in_unit = value_in_base * scalar + offset; 'toBase' states the size of one unit in base units instead (scalar = 1 / toBase) where NIST gives the factor that way. Units flagged compat 'legacy' are spellings kept so imported legacy configuration and user maths resolve; they are defined from their physical meaning and are not offered in unit pickers. Symbols are frozen once shipped (02 section 2.2 rule 5).",
  "quantities": [
    { "name": "Unitless", "family": "Unitless", "dim": [0, 0, 0, 0, 0, 0, 0], "base": "",
      "note": "Quantity 0; its first unit, the empty symbol, is unit 0 (kNoUnit).",
      "units": [
        { "symbol": "", "aliases": ["unitless", "-", "none"] } ] },

    { "name": "Ratio", "family": "Ratio", "dim": [0, 0, 0, 0, 0, 0, 0], "base": "ratio",
      "units": [
        { "symbol": "ratio", "aliases": ["fraction"] },
        { "symbol": "%", "scalar": 100, "aliases": ["percent", "pct", "angle%"] },
        { "symbol": "Trim", "offset": -1, "compat": "legacy", "note": "A multiplier written as its deviation from 1: ratio 1.05 is Trim 0.05." },
        { "symbol": "%Trim", "scalar": 100, "offset": -100, "compat": "legacy", "note": "A multiplier written as its deviation from 1 in percent: ratio 1.05 is 5 %Trim." } ] },

    { "name": "Angle", "family": "Angle", "dim": [0, 0, 0, 0, 0, 0, 0], "base": "rad",
      "note": "Plane angle: dimensionless in the SI, its own display family. Base rad; crank angles are positive after top dead centre.",
      "units": [
        { "symbol": "rad", "aliases": ["radian", "radians"] },
        { "symbol": "deg", "display": "°", "scalar": 57.29577951308232, "aliases": ["degree", "degrees"], "note": "180/pi degrees per radian (SI Brochure, table 8)." },
        { "symbol": "dBTDC", "scalar": -57.29577951308232, "compat": "legacy", "note": "Degrees before top dead centre (ignition advance): crank degrees with the sign flipped." },
        { "symbol": "dRTD", "scalar": 57.29577951308232, "compat": "legacy", "note": "Degrees of ignition retard: crank degrees, positive towards later ignition." } ] },

    { "name": "Air Fuel Ratio", "family": "Air Fuel Ratio", "dim": [0, 0, 0, 0, 0, 0, 0], "base": "lambda",
      "note": "AFR = lambda x stoichiometric ratio (D-010, D-068). The fuel-specific units are fixed-scalar lambda units for imported data and maths; a vehicle's own stoichiometric ratio is the numeric detail 'Stoich Ratio' used by the shipped maths item AFR = 'Lambda' * 'Stoich Ratio', not a unit. A bare 'AFR' spelling names no fuel and is left to the importer's unit mapping (05 section 8).",
      "units": [
        { "symbol": "lambda", "display": "λ", "aliases": ["LA"] },
        { "symbol": "P A/F", "scalar": 14.7, "compat": "legacy", "aliases": ["G A/F"], "note": "Petrol (gasoline) air-fuel ratio, stoichiometric 14.7." },
        { "symbol": "A A/F", "scalar": 6.4, "compat": "legacy", "note": "Alcohol (methanol) air-fuel ratio, stoichiometric 6.4." },
        { "symbol": "D A/F", "scalar": 14.5, "compat": "legacy", "note": "Diesel air-fuel ratio, stoichiometric 14.5." },
        { "symbol": "LPG A/F", "scalar": 15.5, "compat": "legacy", "note": "LPG air-fuel ratio, stoichiometric 15.5." } ] },

    { "name": "Distance", "family": "Distance", "dim": [1, 0, 0, 0, 0, 0, 0], "base": "m", "aliases": ["Length"],
      "units": [
        { "symbol": "m", "aliases": ["meter", "meters", "metre", "metres"] },
        { "symbol": "km", "scalar": 0.001, "aliases": ["kilometer", "kilometers", "kilometre", "kilometres"] },
        { "symbol": "cm", "scalar": 100 },
        { "symbol": "mm", "scalar": 1000, "aliases": ["millimeter", "millimeters", "millimetre", "millimetres"] },
        { "symbol": "in", "toBase": 0.0254, "aliases": ["inch", "inches"], "note": "NIST SP 811: 1 in = 0.0254 m exactly." },
        { "symbol": "ft", "toBase": 0.3048, "aliases": ["foot", "feet"], "note": "NIST SP 811: 1 ft = 0.3048 m exactly." },
        { "symbol": "mi", "toBase": 1609.344, "aliases": ["mile", "miles"], "note": "NIST SP 811: 1 mi (international) = 1609.344 m exactly." } ] },

    { "name": "Speed", "family": "Speed", "dim": [1, 0, -1, 0, 0, 0, 0], "base": "m/s",
      "units": [
        { "symbol": "m/s" },
