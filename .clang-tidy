# Applied to Qt-free targets only (ESSES_ENABLE_CLANG_TIDY, 08 section 3.8). Kept modest: correctness and
# performance families plus naming; the stylistic modernize checks that fight the codebase's choices
# (C arrays for constexpr tables, trailing return types, nodiscard everywhere) are off.
Checks: >
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-exception-escape,
  performance-*,
  modernize-*,
  -modernize-use-trailing-return-type,
  -modernize-avoid-c-arrays,
  -modernize-use-nodiscard,
  -modernize-use-designated-initializers,
  -modernize-use-ranges,
  readability-identifier-naming,
  cppcoreguidelines-pro-type-member-init,
  cppcoreguidelines-slicing,
  misc-unused-*
WarningsAsErrors: '*'
HeaderFilterRegex: 'libs/(base|units|store|model|formats|analysis|maths|project|plotcore)/'
CheckOptions:
  readability-identifier-naming.ClassCase: CamelCase
  readability-identifier-naming.StructCase: CamelCase
  readability-identifier-naming.FunctionCase: camelBack
  readability-identifier-naming.VariableCase: camelBack
  readability-identifier-naming.ParameterCase: camelBack
  readability-identifier-naming.PrivateMemberSuffix: '_'
  readability-identifier-naming.ProtectedMemberSuffix: '_'
  readability-identifier-naming.EnumConstantCase: CamelCase
  readability-identifier-naming.ConstexprVariableCase: CamelCase
  readability-identifier-naming.ConstexprVariablePrefix: 'k'
